  // Natural blinking loop (2.2s - 5.8s interval, ~150ms open->half->closed->open + occasional double blink)
  useEffect(() => {
    let cancelled = false;
    const timeouts: number[] = [];

    const runBlink = (allowDouble: boolean) => {
      if (cancelled) return;
      setBlink('half');
      timeouts.push(
        window.setTimeout(() => {
          if (cancelled) return;
          setBlink('closed');
        }, 40)
      );
      timeouts.push(
        window.setTimeout(() => {
          if (cancelled) return;
          setBlink('half');
        }, 115)
      );
      timeouts.push(
        window.setTimeout(() => {
          if (cancelled) return;
          setBlink('open');
          if (allowDouble && Math.random() < 0.22) {
            timeouts.push(window.setTimeout(() => runBlink(false), 160));
          } else {
            scheduleNext();
          }
        }, 160)
      );
    };

    const scheduleNext = () => {
      const delay = 2200 + Math.random() * 3600;
      timeouts.push(window.setTimeout(() => runBlink(true), delay));
    };

    scheduleNext();
    return () => {
      cancelled = true;
      for (const t of timeouts) window.clearTimeout(t);
    };
